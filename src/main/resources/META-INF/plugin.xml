<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.kldo.deepseek-sync</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Deepseek-Sync</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor>KL_Taekwondo</vendor>
    <version>0.3.0</version>
    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Bring DeepSeek Web Chat into your IDE.<br>
        No more switching between browser and editor — just open the side panel, log in, and start chatting.

        <br><b>Highlights:</b>
        <ul>
            <li>Embedded DeepSeek Web Chat in a side tool window</li>
            <li>One-click access without leaving the IDE</li>
            <li>Stay in flow and get answers faster</li>
            <li>Support DeepSeek Platform in the IDE side panel</li>
            <li>Custom URL browser with navigation and bookmarks</li>
        </ul>

        <br><b>中文介绍：</b>
        <ul>
            <li>将 DeepSeek 网页版带入你的 IDE</li>
            <li>无需切换浏览器，侧边栏直接对话</li>
            <li>保持编码心流，更快获得帮助</li>
            <li>支持查看 DeepSeek Platform 数据</li>
            <li>自定义网址浏览器 + 导航 & 收藏夹</li>
        </ul>
]]></description>

    <change-notes><![CDATA[
<b>0.2.1</b><br>
<ul>
  <li>🤖 AI context menu (Explain/Improve/Review/Test/Comment)</li>
  <li>⌨️ Keyboard shortcuts: Ctrl+Shift+D/O/P/Q/T</li>
  <li>🖱️ Right-click selected code → "发送到 DeepSeek" submenu</li>
  <li>🎨 Unified DeepSeek icons for all actions</li>
</ul>
<b>0.2.1 新增功能</b><br>
<ul>
  <li>🤖 新增 AI 代码操作二级菜单</li>
  <li>⌨️ 专属快捷键，快速调用各种 AI 能力</li>
  <li>🖱️ 选中代码右键直达</li>
</ul>
<b>0.2.0</b><br>
<ul>
  <li>🌐 Custom browser tab with URL persistence</li>
  <li>◀▶ Navigation buttons (go back / forward)</li>
  <li>⭐ Bookmarks (max 15) with collapsible panel</li>
  <li>↗ Open in system browser (for video sites)</li>
  <li>🔀 Fixed tab links → auto open in custom tab</li>
  <li>🎯 Popup windows intercepted, loaded in-plugin</li>
  <li>⌨️ Global shortcut to toggle sidebar (Ctrl+Shift+S)</li>
  <li>🔄 URL bar syncs with page navigation</li>
  <li>🎨 Hover animation effects on toolbar buttons</li>
</ul>
<b>0.2.0 新增功能</b><br>
<ul>
  <li>🌐 自定义浏览器标签页，URL 持久化保存</li>
  <li>◀▶ 前进/后退导航按钮</li>
  <li>⭐ 收藏夹（最多 15 条），可折叠面板</li>
  <li>↗ 系统浏览器打开（视频网站兜底）</li>
  <li>🔀 固定标签页点链接 → 自动转到自定义页打开</li>
  <li>🎯 弹窗拦截，在插件内打开</li>
  <li>⌨️ 全局快捷键切换侧栏（Ctrl+Shift+S）</li>
  <li>🔄 地址栏随页面导航自动同步</li>
  <li>🎨 工具栏按钮悬停动效</li>
</ul>
    ]]></change-notes>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.compose</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="DeepSeek-Sync"
                    factoryClass="com.kldo.DeepSeekSyncFactory"
                    icon="/META-INF/actionIcon.svg"/>
        <notificationGroup id="DeepSeek-Sync"
                           displayType="BALLOON" bundle="messages.MyMessageBundle"
                           key="notification.group.deepseek-sync"/>
        <applicationConfigurable instance="com.kldo.DeepSeekSyncPromptConfigurable"
                                  parentId="tools"
                                  id="com.kldo.DeepSeekSyncPromptConfigurable"
                                  displayName="DeepSeek-Sync"/>
    </extensions>

    <actions>
        <group id="DeepSeekSync.DeepSeekAIActions"
               class="com.kldo.DeepSeekAIActionGroup"
               icon="/META-INF/actionIcon.svg"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>

            <action id="DeepSeekSync.ExplainCode"
                    class="com.kldo.DeepSeekAIAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift D"/>
            </action>

            <action id="DeepSeekSync.ImproveCode"
                    class="com.kldo.DeepSeekAIAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift O"/>
            </action>
            <action id="DeepSeekSync.ReviewCode"
                    class="com.kldo.DeepSeekAIAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift P"/>
            </action>
            <action id="DeepSeekSync.TestCode"
                    class="com.kldo.DeepSeekAIAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift Q"/>
            </action>
            <action id="DeepSeekSync.CommentCode"
                    class="com.kldo.DeepSeekAIAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift T"/>
            </action>

            <action id="DeepSeekSync.OpenSettings"
                    class="com.kldo.OpenSettingsAction"/>
        </group>

        <action id="DeepSeekSync.OpenDeepSeek"
                class="com.kldo.OpenDeepSeekAction"
                icon="/META-INF/actionIcon.svg">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift S"/>
        </action>
        <action id="DeepSeekSync.ExplainTerminalError"
                class="com.kldo.ExplainTerminalErrorAction"
                icon="/META-INF/actionIcon.svg">
            <add-to-group group-id="Terminal.ReworkedTerminalContextMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>